{%- comment -%}
  PURELANE — ICON
  ---------------------------------------------------------------------------
  The prototype inlined 68 <svg> blocks, many of them the same leaf, check or
  arrow repeated verbatim. Every one is defined once here instead.

  Icons are inlined rather than referenced from a sprite because they inherit
  `currentColor` at several different sizes and colours across the page, and an
  external sprite would add a render-blocking request for ~2 KB of paths.

  All icons are decorative: they sit beside a visible text label everywhere the
  prototype used them, so each carries aria-hidden="true" and the surrounding
  element supplies the accessible name.

  Accepts:
    name          string  required. See the case list below.
    stroke_width  number  optional. Falls back to the prototype's value per icon.
    class         string  optional. Extra classes on the <svg>.

  Usage:
    {% render 'purelane-icon', name: 'leaf' %}
    {% render 'purelane-icon', name: 'arrow-right', class: 'pl-btn__arrow' %}
{%- endcomment -%}

{%- liquid
  assign icon_name = name | default: '' | strip
  assign icon_class = class | default: ''

  case icon_name
    when 'check', 'check-bold'
      assign default_stroke = 2.4
    when 'arrow-right'
      assign default_stroke = 2.2
    when 'check-round'
      assign default_stroke = 3
    when 'search', 'account', 'cart'
      assign default_stroke = 1.7
    when 'menu'
      assign default_stroke = 1.8
    when 'logo', 'leaf-stem', 'box', 'heart', 'globe'
      assign default_stroke = 1.5
    else
      assign default_stroke = 1.6
  endcase

  assign sw = stroke_width | default: default_stroke
-%}

<svg
  class="pl-icon {{ icon_class }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="{{ sw }}"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon_name -%}

    {%- comment -%} Brand leaf. The most reused mark on the page. {%- endcomment -%}
    {%- when 'leaf' -%}
      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
      <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>

    {%- when 'leaf-stem' -%}
      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
      <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
      <path d="M12 21v-6"/>

    {%- comment -%} Safe for kids and pets. {%- endcomment -%}
    {%- when 'shield-check' -%}
      <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
      <path d="m9 12 2.2 2.2L15.4 10"/>

    {%- comment -%} Zero harsh chemicals. {%- endcomment -%}
    {%- when 'no-chem' -%}
      <circle cx="12" cy="12" r="8.4"/>
      <path d="M6.4 17.6 17.6 6.4"/>

    {%- when 'arrow-right' -%}
      <path d="M5 12h13m-5-6 6 6-6 6"/>

    {%- when 'check', 'check-bold', 'check-round' -%}
      <path d="m5 13 4 4L19 7"/>

    {%- when 'heart' -%}
      <path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/>

    {%- comment -%} Foaming action, used by the "less scrubbing" pillar. {%- endcomment -%}
    {%- when 'bubbles' -%}
      <circle cx="8" cy="8.5" r="3.2"/>
      <circle cx="16.4" cy="6.6" r="2.2"/>
      <circle cx="15" cy="13" r="2.8"/>
      <circle cx="8.6" cy="15.6" r="2.1"/>
      <path d="M4 21h16"/>

    {%- comment -%} Recyclable packaging. {%- endcomment -%}
    {%- when 'box' -%}
      <path d="M4 8h16v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/>
      <path d="M4 8 6.5 3h11L20 8M9.5 12h5"/>

    {%- comment -%} Made in India. {%- endcomment -%}
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="8.6"/>
      <path d="M3.4 12h17.2M12 3.4c2.4 2.4 3.6 5.4 3.6 8.6S14.4 18.2 12 20.6c-2.4-2.4-3.6-5.4-3.6-8.6S9.6 5.8 12 3.4Z"/>

    {%- comment -%} Savings. {%- endcomment -%}
    {%- when 'rupee' -%}
      <path d="M12 3v18"/>
      <path d="M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2"/>

    {%- comment -%} One flat price. {%- endcomment -%}
    {%- when 'square-check' -%}
      <rect x="4" y="4" width="16" height="16" rx="3.4"/>
      <path d="m8.4 12.2 2.4 2.4 4.8-5"/>

    {%- comment -%} Curated by experts. {%- endcomment -%}
    {%- when 'star' -%}
      <path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/>

    {%- comment -%} Free shipping. {%- endcomment -%}
    {%- when 'truck' -%}
      <path d="M2.6 16.4V7.2h10.2v9.2"/>
      <path d="M12.8 10.4h4l3.6 3.2v2.8h-7.6"/>
      <circle cx="6.6" cy="18" r="1.9"/>
      <circle cx="16.6" cy="18" r="1.9"/>

    {%- comment -%} Purelane wordmark cube. {%- endcomment -%}
    {%- when 'logo' -%}
      <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
      <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>

    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/>
      <path d="m20 20-3.5-3.5"/>

    {%- when 'account' -%}
      <circle cx="12" cy="8" r="3.6"/>
      <path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/>

    {%- when 'cart' -%}
      <path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/>
      <circle cx="10" cy="20.5" r="1.1"/>
      <circle cx="17.5" cy="20.5" r="1.1"/>

    {%- when 'menu' -%}
      <path d="M4 8h16M4 16h16"/>

  {%- endcase -%}
</svg>
