{%- comment -%}
  PURELANE — PILLARS
  The three benefit cards: less scrubbing, clean ingredients, safe around
  everyone. Each is a glass card with an icon, a heading, copy and a link.
{%- endcomment -%}

{{ 'purelane-tokens.css' | asset_url | stylesheet_tag }}
{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-icon-grid.css' | asset_url | stylesheet_tag }}

<script src="{{ 'purelane-reveal.js' | asset_url }}" defer></script>

{%- if section.blocks.size > 0 -%}
  <div class="pl pl-sec" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %} data-pl-scene="{{ section.settings.scene }}">
    <div class="pl-wrap">

      {% render 'purelane-section-head',
        kicker: section.settings.kicker,
        heading: section.settings.heading,
        heading_level: section.settings.heading_level,
        show_rule: section.settings.show_rule
      %}

      <div class="pl-pillars" style="--pl-pillars-columns: {{ section.settings.columns }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign delay = ''
            if forloop.index0 > 0
              assign next = forloop.index0 | plus: 1
              assign delay = 'pl-rv--d' | append: next
            endif
          -%}
          <article class="pl-glass pl-pillar pl-rv {{ delay }}" {{ block.shopify_attributes }}>
            <span class="pl-pillar__icon">
              {% render 'purelane-icon', name: block.settings.icon %}
            </span>

            {%- if block.settings.title != blank -%}
              <h3 class="pl-d3">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="pl-body-s">{{ block.settings.text }}</p>
            {%- endif -%}

            {%- if block.settings.cta_label != blank and block.settings.cta_link != blank -%}
              <a class="pl-btn pl-btn--ghost pl-btn--sm" href="{{ block.settings.cta_link }}">
                {{ block.settings.cta_label }}
                {%- comment -%}
                  Three identical "Learn more" links on one page are
                  indistinguishable in a screen reader's link list, so each
                  carries its own pillar name.
                {%- endcomment -%}
                <span class="pl-visually-hidden">about {{ block.settings.title }}</span>
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>

    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Purelane pillars",
  "tag": "section",
  "class": "purelane-section purelane-section--pillars",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Lets links and the progress rail jump here, e.g. shop. Omit the #.",
      "default": "how"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "scene",
      "label": "Backdrop depth",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "bubbles", "label": "Foam" },
            { "value": "shield-check", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "no-chem", "label": "No chemicals" }
          ],
          "default": "bubbles"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Less scrubbing"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Link label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane pillars",
      "blocks": [
        { "type": "pillar" },
        {
          "type": "pillar",
          "settings": {
            "icon": "shield-check",
            "title": "Clean ingredients",
            "text": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "heart",
            "title": "Safe around everyone",
            "text": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day."
          }
        }
      ]
    }
  ]
}
{% endschema %}
