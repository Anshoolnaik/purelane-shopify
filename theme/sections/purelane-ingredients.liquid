{%- comment -%}
  PURELANE — INGREDIENTS
  "Sourced from nature" — the five botanical drawings.

  Each ingredient is a block choosing one of the five drawings, so a merchant
  can reorder them, drop one, or reuse a drawing for a new ingredient without
  touching code.
{%- endcomment -%}

{{ 'purelane-tokens.css' | asset_url | stylesheet_tag }}
{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-ingredients.css' | asset_url | stylesheet_tag }}

<script src="{{ 'purelane-reveal.js' | asset_url }}" defer></script>

<div class="pl pl-sec" data-pl-scene="{{ section.settings.scene }}">
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad pl-rv">

      {% render 'purelane-section-head',
        kicker: section.settings.kicker,
        heading: section.settings.heading,
        heading_level: section.settings.heading_level,
        show_rule: section.settings.show_rule
      %}

      {%- if section.blocks.size > 0 -%}
        <div
          class="pl-ingredients"
          style="--pl-ingredients-columns: {{ section.blocks.size }};"
        >
          {%- for block in section.blocks -%}
            <div class="pl-ingredient" {{ block.shopify_attributes }}>
              <div class="pl-ingredient__art">
                {% render 'purelane-botanical', name: block.settings.art %}
              </div>

              {%- if block.settings.name != blank -%}
                <h3 class="pl-ingredient__name">{{ block.settings.name }}</h3>
              {%- endif -%}

              {%- if block.settings.note != blank -%}
                <p>{{ block.settings.note }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purelane ingredients",
  "tag": "section",
  "class": "purelane-section purelane-section--ingredients",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sourced from nature"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "scene",
      "label": "Backdrop depth",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "select",
          "id": "art",
          "label": "Drawing",
          "options": [
            { "value": "coconut", "label": "Coconut" },
            { "value": "orange-peel", "label": "Orange peel" },
            { "value": "soap-nut", "label": "Soap nut" },
            { "value": "neem", "label": "Neem" },
            { "value": "lemongrass", "label": "Lemongrass" }
          ],
          "default": "coconut"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Coconut"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "Plant-derived cleansers that lift grease"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane ingredients",
      "blocks": [
        { "type": "ingredient" },
        {
          "type": "ingredient",
          "settings": { "art": "orange-peel", "name": "Orange peel", "note": "Natural degreaser and fresh citrus lift" }
        },
        {
          "type": "ingredient",
          "settings": { "art": "soap-nut", "name": "Soap nut", "note": "A traditional plant foaming agent" }
        },
        {
          "type": "ingredient",
          "settings": { "art": "neem", "name": "Neem", "note": "Time-tested antibacterial from the tree" }
        },
        {
          "type": "ingredient",
          "settings": { "art": "lemongrass", "name": "Lemongrass", "note": "Clean fragrance with nothing synthetic" }
        }
      ]
    }
  ]
}
{% endschema %}
