{%- comment -%}
  PURELANE — BUNDLES
  ---------------------------------------------------------------------------
  The build-your-box tiers: pick any 2, 3 or 5 products at a flat price.

  Each tier is a block pointing at the real bundle product that sells at that
  price, so price and compare-at come from Shopify. The per-product line
  ("Flat ₹174 per product") is calculated from that price and the tier
  quantity rather than typed — in the prototype those three figures were hand
  written and rounded inconsistently (₹349/2 shown as ₹174, ₹499/3 as ₹166,
  ₹799/5 as ₹160: two floored, one rounded). A merchant can still override the
  line where a marketing figure is wanted.

  Feature lists are one per line in a textarea rather than a fixed set of
  fields, so a tier can carry two bullets or five without the schema
  dictating it.
{%- endcomment -%}

{{ 'purelane-tokens.css' | asset_url | stylesheet_tag }}
{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-silhouettes.css' | asset_url | stylesheet_tag }}
{{ 'purelane-bundles.css' | asset_url | stylesheet_tag }}

<script src="{{ 'purelane-reveal.js' | asset_url }}" defer></script>

<div class="pl pl-sec" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %} data-pl-scene="{{ section.settings.scene }}">
  <div class="pl-wrap">

    {%- if section.settings.kicker != blank
      or section.settings.heading != blank
      or section.settings.lede != blank
    -%}
      <div class="pl-glass pl-sec-pad pl-bundles__intro pl-rv">
        {% render 'purelane-section-head',
          kicker: section.settings.kicker,
          heading: section.settings.heading,
          lede: section.settings.lede,
          heading_level: section.settings.heading_level,
          show_rule: section.settings.show_rule
        %}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="pl-tiers" style="--pl-tier-columns: {{ section.settings.columns }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign bundle = block.settings.bundle_product
            assign qty = block.settings.quantity

            comment
              Tray shots. Collected into a list first so the count can size
              them, rather than relying on a hand-applied "five" class.
            endcomment
            assign shots = ''
            for i in (1..5)
              case i
                when 1
                  assign candidate = block.settings.product_1
                when 2
                  assign candidate = block.settings.product_2
                when 3
                  assign candidate = block.settings.product_3
                when 4
                  assign candidate = block.settings.product_4
                else
                  assign candidate = block.settings.product_5
              endcase
              if candidate != blank
                assign shots = shots | append: i | append: ','
              endif
            endfor
            assign shot_keys = shots | split: ','

            comment
              Per-product price. The template keeps the wording in the
              merchant's hands and out of the code; {price} is substituted
              with the money-formatted figure.
            endcomment
            assign unit_line = ''
            if block.settings.unit_label != blank
              assign unit_line = block.settings.unit_label
            elsif bundle != blank and qty > 0 and block.settings.unit_template != blank
              assign unit_price = bundle.price | divided_by: qty | round | money
              assign unit_line = block.settings.unit_template | replace: '{price}', unit_price
            endif

            assign features = block.settings.features | newline_to_br | split: '<br />'

            assign delay = ''
            if forloop.index0 > 0
              assign delay = 'pl-rv--d' | append: forloop.index0
            endif
          -%}

          <article
            class="pl-glass pl-tier pl-rv {{ delay }}{% if block.settings.featured %} pl-tier--featured{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.tag != blank -%}
              <span class="pl-tier__tag">{{ block.settings.tag }}</span>
            {%- endif -%}

            {%- if shot_keys.size > 0 -%}
              <div class="pl-tier__pix" data-count="{{ shot_keys.size }}" aria-hidden="true">
                {%- for key in shot_keys -%}
                  {%- liquid
                    case key
                      when '1'
                        assign item = block.settings.product_1
                      when '2'
                        assign item = block.settings.product_2
                      when '3'
                        assign item = block.settings.product_3
                      when '4'
                        assign item = block.settings.product_4
                      else
                        assign item = block.settings.product_5
                    endcase
                  -%}
                  {% render 'purelane-product-media', product: item, sizes: '62px' %}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if qty > 0 -%}
              {%- comment -%}
                The number and its label read as one phrase, so they are joined
                for assistive tech instead of being announced as "3" then
                "Products" from two separate nodes.
              {%- endcomment -%}
              <div class="pl-tier__qty">
                <span aria-hidden="true">{{ qty }}</span>
                <small aria-hidden="true">{{ block.settings.quantity_label }}</small>
                <span class="pl-visually-hidden">
                  {{- qty }} {{ block.settings.quantity_label -}}
                </span>
              </div>
            {%- endif -%}

            {%- if bundle != blank -%}
              {% render 'purelane-price', product: bundle, class: 'pl-tier__price' %}
            {%- endif -%}

            {%- if unit_line != blank -%}
              <p class="pl-body-s pl-tier__unit">{{ unit_line }}</p>
            {%- endif -%}

            {%- if block.settings.features != blank -%}
              <ul class="pl-tier__list">
                {%- for feature in features -%}
                  {%- assign clean = feature | strip_html | strip -%}
                  {%- if clean != blank -%}
                    <li>
                      {% render 'purelane-icon', name: 'check' %}
                      {{ clean }}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- liquid
              assign cta_url = block.settings.cta_link
              if cta_url == blank and bundle != blank
                assign cta_url = bundle.url
              endif
              assign cta_style = 'pl-btn--ghost'
              if block.settings.featured
                assign cta_style = 'pl-btn--primary'
              endif
            -%}

            {%- if block.settings.cta_label != blank and cta_url != blank -%}
              <a class="pl-btn {{ cta_style }} pl-btn--block" href="{{ cta_url }}">
                {{ block.settings.cta_label }}
                <span class="pl-visually-hidden">
                  {{- ': ' }}{{ block.settings.tag | default: block.settings.quantity_label -}}
                </span>
                {%- if block.settings.featured %}
                  {% render 'purelane-icon', name: 'arrow-right' %}
                {%- endif -%}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Purelane bundles",
  "tag": "section",
  "class": "purelane-section purelane-section--bundles",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Lets links and the progress rail jump here, e.g. shop. Omit the #.",
      "default": "bundles"
    },
    {
      "type": "header",
      "content": "Intro panel"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Supporting text",
      "default": "<p>Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "scene",
      "label": "Backdrop depth",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Starter"
        },
        {
          "type": "product",
          "id": "bundle_product",
          "label": "Bundle product",
          "info": "The product that sells at this tier's price. Price and compare-at price are read from it."
        },
        {
          "type": "range",
          "id": "quantity",
          "label": "Products in the box",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 2
        },
        {
          "type": "text",
          "id": "quantity_label",
          "label": "Quantity label",
          "default": "Products"
        },
        {
          "type": "text",
          "id": "unit_template",
          "label": "Per-product line template",
          "info": "{price} is replaced with the bundle price divided by the quantity above.",
          "default": "Flat {price} per product"
        },
        {
          "type": "text",
          "id": "unit_label",
          "label": "Per-product line override",
          "info": "Optional. Replaces the calculated line entirely."
        },
        {
          "type": "header",
          "content": "Products shown in the tray"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        },
        {
          "type": "product",
          "id": "product_5",
          "label": "Product 5"
        },
        {
          "type": "header",
          "content": "Features"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Feature list",
          "info": "One per line.",
          "default": "Pick any two products\nFree shipping across India"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight this tier",
          "default": false
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link",
          "info": "Leave empty to link to the bundle product."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": { "tag": "Starter", "quantity": 2 }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Most popular",
            "quantity": 3,
            "featured": true,
            "features": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Whole home",
            "quantity": 5,
            "features": "Pick any five products\nEvery room in one order\nFree shipping across India"
          }
        }
      ]
    }
  ]
}
{% endschema %}
