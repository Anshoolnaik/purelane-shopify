{%- comment -%}
  PURELANE — FULL RANGE
  "Every room, one shelf" — the whole product line stood up in a row.

  Sourced from a collection so it stays the full range as the catalogue grows,
  rather than a fixed row of images that goes stale on every launch.
{%- endcomment -%}

{{ 'purelane-tokens.css' | asset_url | stylesheet_tag }}
{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-silhouettes.css' | asset_url | stylesheet_tag }}
{{ 'purelane-showcase.css' | asset_url | stylesheet_tag }}

<script src="{{ 'purelane-reveal.js' | asset_url }}" defer></script>

{%- liquid
  assign shelf = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<div class="pl pl-sec" data-pl-scene="{{ section.settings.scene }}">
  <div class="pl-wrap">
    <div class="pl-glass pl-range pl-rv">

      <div class="pl-range__head">
        <div>
          {%- if section.settings.kicker != blank -%}
            <span class="pl-kicker">{{ section.settings.kicker }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="pl-d2" style="margin-top: 10px;">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.text != blank -%}
          <div class="pl-body-s">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if shelf != blank and shelf.products.size > 0 -%}
        {%- comment -%}
          Focusable and labelled: below 760px this strip scrolls horizontally,
          and a scroll container with no focusable child cannot be reached
          from a keyboard.
        {%- endcomment -%}
        <div
          class="pl-range__strip"
          tabindex="0"
          role="group"
          aria-label="{{ section.settings.strip_label | default: 'The full product range' | escape }}"
        >
          <div class="pl-range__row">
            {%- for product in shelf.products limit: limit -%}
              {% render 'purelane-product-media', product: product, sizes: '132px' %}
            {%- endfor -%}
          </div>
        </div>

        {%- if section.settings.hint != blank -%}
          <p class="pl-range__hint">{{ section.settings.hint }}</p>
        {%- endif -%}
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purelane full range",
  "tag": "section",
  "class": "purelane-section purelane-section--range",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "The full range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every room, one shelf"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Floors, taps, kitchen, laundry, bathroom and hands. Plant-based formulas that replace every harsh bottle under your sink.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Every product in this collection is shown, so the shelf grows with the catalogue."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maximum products",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "text",
      "id": "strip_label",
      "label": "Strip accessible label",
      "default": "The full product range"
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Mobile scroll hint",
      "info": "Shown only at widths where the shelf scrolls.",
      "default": "Swipe to see the full shelf"
    },
    {
      "type": "range",
      "id": "scene",
      "label": "Backdrop depth",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Purelane full range"
    }
  ]
}
{% endschema %}
