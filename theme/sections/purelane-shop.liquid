{%- comment -%}
  PURELANE — SHOP GRID
  ---------------------------------------------------------------------------
  The bestseller shelf. The prototype hardcoded four cards with identical
  prices and invented review counts; this renders real products.

  Two sourcing modes, because both are real merchandising needs:
    Collection — the grid follows a collection and updates itself as the
                 merchant merchandises it. No template edit to change what
                 shows.
    Manual     — hand-picked products in a chosen order, as blocks.

  The card itself lives in snippets/purelane-product-card.liquid so this
  section owns layout only.
{%- endcomment -%}

{{ 'purelane-tokens.css' | asset_url | stylesheet_tag }}
{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-silhouettes.css' | asset_url | stylesheet_tag }}
{{ 'purelane-product-card.css' | asset_url | stylesheet_tag }}
{{ 'purelane-shop.css' | asset_url | stylesheet_tag }}

<script src="{{ 'purelane-reveal.js' | asset_url }}" defer></script>

{%- liquid
  assign source = section.settings.source
  assign limit = section.settings.products_to_show
  assign columns = section.settings.columns_desktop

  comment
    `sizes` has to match the real rendered width or the browser downloads the
    wrong candidate. Derived from the column count rather than hardcoded.
  endcomment
  assign col_width = 1180 | divided_by: columns
  assign card_sizes = '(min-width: 860px) ' | append: col_width | append: 'px, 44vw'
-%}

<div class="pl pl-sec" data-pl-scene="{{ section.settings.scene }}">
  <div class="pl-wrap">

    {% render 'purelane-section-head',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      lede: section.settings.lede,
      heading_level: section.settings.heading_level,
      show_rule: section.settings.show_rule
    %}

    <div class="pl-shelf" style="--pl-shelf-columns: {{ columns }};">

      {%- if source == 'collection' -%}

        {%- if section.settings.collection != blank -%}
          {%- for product in section.settings.collection.products limit: limit -%}
            {%- liquid
              assign delay_index = forloop.index0 | modulo: 4
              assign delay = ''
              if delay_index > 0
                assign delay = 'pl-rv--d' | append: delay_index
              endif
            -%}
            {% render 'purelane-product-card',
              product: product,
              reveal_delay: delay,
              sizes: card_sizes,
              heading_level: section.settings.card_heading_level
            %}
          {%- else -%}
            <p class="pl-shelf__empty">
              This collection has no products yet.
            </p>
          {%- endfor -%}
        {%- else -%}
          <p class="pl-shelf__empty">
            Choose a collection in the section settings to show products here.
          </p>
        {%- endif -%}

      {%- else -%}

        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {%- liquid
              assign delay_index = forloop.index0 | modulo: 4
              assign delay = ''
              if delay_index > 0
                assign delay = 'pl-rv--d' | append: delay_index
              endif
            -%}
            {% render 'purelane-product-card',
              product: block.settings.product,
              reveal_delay: delay,
              sizes: card_sizes,
              heading_level: section.settings.card_heading_level,
              block_attributes: block.shopify_attributes
            %}
          {%- endif -%}
        {%- else -%}
          <p class="pl-shelf__empty">
            Add a product block to show products here.
          </p>
        {%- endfor -%}

      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purelane shop grid",
  "tag": "section",
  "class": "purelane-section purelane-section--shop",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Supporting text"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "info": "Use H1 only if this is the first heading on the page.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "collection", "label": "From a collection" },
        { "value": "manual", "label": "Hand-picked (product blocks)" }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when the source is set to collection."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "info": "Mobile is always two columns.",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "card_heading_level",
      "label": "Product title level",
      "info": "Should sit one level below the section heading.",
      "options": [
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "scene",
      "label": "Backdrop depth",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane shop grid"
    }
  ]
}
{% endschema %}
