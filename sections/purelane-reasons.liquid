{%- comment -%}
  PURELANE — REASONS GRID
  "Why bundles beat buying single" — a heading panel over a grid of
  icon-and-copy reasons.
{%- endcomment -%}

{{ 'purelane-tokens.css' | asset_url | stylesheet_tag }}
{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-icon-grid.css' | asset_url | stylesheet_tag }}

<script src="{{ 'purelane-reveal.js' | asset_url }}" defer></script>

<div class="pl pl-sec" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %} data-pl-scene="{{ section.settings.scene }}">
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad pl-rv">

      {% render 'purelane-section-head',
        kicker: section.settings.kicker,
        heading: section.settings.heading,
        heading_level: section.settings.heading_level,
        show_rule: section.settings.show_rule
      %}

      {%- if section.blocks.size > 0 -%}
        <div class="pl-reasons" style="--pl-reasons-columns: {{ section.settings.columns }};">
          {%- for block in section.blocks -%}
            <div class="pl-reasons__item" {{ block.shopify_attributes }}>
              <span class="pl-reasons__icon">
                {% render 'purelane-icon', name: block.settings.icon %}
              </span>
              {%- if block.settings.title != blank -%}
                <h3 class="pl-reasons__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purelane reasons",
  "tag": "section",
  "class": "purelane-section purelane-section--reasons",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Lets links and the progress rail jump here, e.g. shop. Omit the #.",
      "default": "why-bundles"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "The smarter way to shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why bundles beat buying single"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "scene",
      "label": "Backdrop depth",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "rupee", "label": "Savings" },
            { "value": "square-check", "label": "Flat price" },
            { "value": "star", "label": "Curated" },
            { "value": "truck", "label": "Shipping" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield-check", "label": "Shield" }
          ],
          "default": "rupee"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Save up to 45%"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Versus buying the same products separately"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane reasons",
      "blocks": [
        {
          "type": "reason",
          "settings": { "icon": "rupee", "title": "Save up to 45%", "text": "Versus buying the same products separately" }
        },
        {
          "type": "reason",
          "settings": { "icon": "square-check", "title": "One flat price", "text": "No calculators, no comparing carts" }
        },
        {
          "type": "reason",
          "settings": { "icon": "star", "title": "Curated by experts", "text": "Products picked to work well together" }
        },
        {
          "type": "reason",
          "settings": { "icon": "truck", "title": "Free shipping always", "text": "Included on every bundle, all India" }
        }
      ]
    }
  ]
}
{% endschema %}
