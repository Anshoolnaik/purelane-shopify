{%- comment -%}
  PURELANE — BEST SELLING COMBOS
  ---------------------------------------------------------------------------
  A scrolling rail of pre-built combos, each showing the products inside it
  and the saving against buying them separately.

  A combo is not a native Shopify object, so it is modelled as a block holding
  real products plus the bundle product that actually sells at the combo price.
  Every number on the card — price, compare-at, saving — comes from that
  product. The prototype typed all of them by hand, and its own numbers
  disagreed: the "Complete home bundle" card claimed five products while
  showing three.

  Per-product benefit lines ("Cuts grease instantly") come from the
  `purelane.benefit` product metafield, so the same wording follows a product
  into every combo it appears in instead of being retyped per card.

  Accessibility: the prototype's rail could only be moved by pointer. It is
  now a labelled, focusable scroll region, so it can be reached and scrolled
  from the keyboard.
{%- endcomment -%}

{{ 'purelane-tokens.css' | asset_url | stylesheet_tag }}
{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-silhouettes.css' | asset_url | stylesheet_tag }}
{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}

<script src="{{ 'purelane-reveal.js' | asset_url }}" defer></script>

<div class="pl pl-sec" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %} data-pl-scene="{{ section.settings.scene }}">
  <div class="pl-wrap">

    {% render 'purelane-section-head',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      lede: section.settings.lede,
      heading_level: section.settings.heading_level,
      show_rule: section.settings.show_rule
    %}

    {%- if section.blocks.size > 0 -%}
      <div
        class="pl-combos__rail pl-rv"
        tabindex="0"
        role="group"
        aria-label="{{ section.settings.rail_label | default: 'Best selling combos' | escape }}"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign bundle = block.settings.bundle_product

            comment
              Collect the picked products into an array so the "+" separators
              can be placed between them rather than after every one.
            endcomment
            assign picked = ''
            for i in (1..5)
              case i
                when 1
                  assign candidate = block.settings.product_1
                when 2
                  assign candidate = block.settings.product_2
                when 3
                  assign candidate = block.settings.product_3
                when 4
                  assign candidate = block.settings.product_4
                else
                  assign candidate = block.settings.product_5
              endcase
              if candidate != blank
                assign picked = picked | append: i | append: ','
              endif
            endfor
            assign picked_keys = picked | split: ','

            comment
              Count label: the number of products actually in the combo,
              overridable because a merchant may bundle more items than the
              tray has room to show.
            endcomment
            if block.settings.count_label != blank
              assign count_label = block.settings.count_label
            else
              assign count_label = picked_keys.size | append: ' products'
            endif

            comment
              Saving badge: derived from the bundle product's own prices unless
              the merchant writes something specific like "Biggest saving".
            endcomment
            assign saved = 0
            if bundle.compare_at_price > bundle.price
              assign saved = bundle.compare_at_price | minus: bundle.price
            endif
          -%}

          <article
            class="pl-glass pl-combo{% if block.settings.featured %} pl-combo--featured{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="pl-combo__tray">
              {%- if block.settings.save_label != blank -%}
                <span class="pl-combo__save">{{ block.settings.save_label }}</span>
              {%- elsif saved > 0 -%}
                <span class="pl-combo__save">You save {{ saved | money }}</span>
              {%- endif -%}

              {%- if block.settings.flag_label != blank -%}
                <span class="pl-combo__flag">{{ block.settings.flag_label }}</span>
              {%- endif -%}

              {%- if picked_keys.size > 0 -%}
                <div class="pl-combo__stack">
                  {%- for key in picked_keys -%}
                    {%- liquid
                      case key
                        when '1'
                          assign item = block.settings.product_1
                        when '2'
                          assign item = block.settings.product_2
                        when '3'
                          assign item = block.settings.product_3
                        when '4'
                          assign item = block.settings.product_4
                        else
                          assign item = block.settings.product_5
                      endcase
                      assign benefit = item.metafields.purelane.benefit.value
                    -%}

                    {%- unless forloop.first -%}
                      <span class="pl-combo__plus" aria-hidden="true">+</span>
                    {%- endunless -%}

                    <span class="pl-combo__item">
                      {% render 'purelane-product-media',
                        product: item,
                        sizes: '66px'
                      %}
                      {%- if benefit != blank -%}
                        <span>{{ benefit }}</span>
                      {%- endif -%}
                    </span>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>

            <div class="pl-combo__body">
              {%- if block.settings.title != blank -%}
                <h3 class="pl-combo__title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if picked_keys.size > 0 or block.settings.count_label != blank -%}
                <div class="pl-combo__count">{{ count_label }}</div>
              {%- endif -%}

              {%- if block.settings.includes != blank -%}
                <p class="pl-combo__includes">{{ block.settings.includes }}</p>
              {%- endif -%}

              {%- if bundle != blank -%}
                {% render 'purelane-price',
                  product: bundle,
                  saving: 'amount',
                  class: 'pl-combo__price'
                %}
              {%- endif -%}

              {%- if block.settings.fine_print != blank -%}
                <div class="pl-combo__fine">{{ block.settings.fine_print }}</div>
              {%- endif -%}

              {%- liquid
                assign cta_url = block.settings.cta_link
                if cta_url == blank and bundle != blank
                  assign cta_url = bundle.url
                endif
                assign cta_style = 'pl-btn--ghost'
                if block.settings.featured
                  assign cta_style = 'pl-btn--primary'
                endif
              -%}

              {%- if block.settings.cta_label != blank and cta_url != blank -%}
                <a class="pl-btn {{ cta_style }} pl-btn--block" href="{{ cta_url }}">
                  {{ block.settings.cta_label }}
                  <span class="pl-visually-hidden">
                    {{- ': ' }}{{ block.settings.title -}}
                  </span>
                  {% render 'purelane-icon', name: 'arrow-right' %}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.swipe_cue != blank -%}
        <div class="pl-combos__cue" aria-hidden="true">
          {% render 'purelane-icon', name: 'arrow-right' %}
          {{ section.settings.swipe_cue }}
        </div>
      {%- endif -%}

      {%- if section.settings.rail_note != blank -%}
        <p class="pl-combos__note">{{ section.settings.rail_note }}</p>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "section",
  "class": "purelane-section purelane-section--combos",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Lets links and the progress rail jump here, e.g. shop. Omit the #.",
      "default": "combos"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Supporting text",
      "default": "<p>Swipe through the boxes people order most. Each one is already priced below buying the same products on their own.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Rail"
    },
    {
      "type": "text",
      "id": "rail_label",
      "label": "Rail accessible label",
      "info": "Describes the scrolling rail to screen reader users.",
      "default": "Best selling combos"
    },
    {
      "type": "text",
      "id": "swipe_cue",
      "label": "Swipe hint",
      "default": "Swipe for more combos"
    },
    {
      "type": "richtext",
      "id": "rail_note",
      "label": "Note below the rail",
      "default": "<p>Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay.</p>"
    },
    {
      "type": "range",
      "id": "scene",
      "label": "Backdrop depth",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen essentials"
        },
        {
          "type": "product",
          "id": "bundle_product",
          "label": "Bundle product",
          "info": "The product that sells at this combo price. Price, compare-at price and the saving are all read from it."
        },
        {
          "type": "header",
          "content": "Products shown in the tray"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        },
        {
          "type": "product",
          "id": "product_5",
          "label": "Product 5"
        },
        {
          "type": "header",
          "content": "Labels"
        },
        {
          "type": "text",
          "id": "count_label",
          "label": "Product count label",
          "info": "Leave empty to count the products above automatically."
        },
        {
          "type": "text",
          "id": "save_label",
          "label": "Saving badge",
          "info": "Leave empty to calculate it from the bundle product."
        },
        {
          "type": "text",
          "id": "flag_label",
          "label": "Corner flag",
          "info": "Optional, e.g. Most popular."
        },
        {
          "type": "textarea",
          "id": "includes",
          "label": "What's included",
          "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner. Everything for a sparkling kitchen, no need to pick separately."
        },
        {
          "type": "text",
          "id": "fine_print",
          "label": "Fine print",
          "default": "Inclusive of all taxes · COD available"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight this combo",
          "info": "Adds the accent outline and a solid button.",
          "default": false
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link",
          "info": "Leave empty to link to the bundle product."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane combos",
      "blocks": [
        { "type": "combo" },
        { "type": "combo" },
        { "type": "combo", "settings": { "featured": true } }
      ]
    }
  ]
}
{% endschema %}
